{
  "name": "SRPA-Net matched 2x2 factorial reliability and spectral detail",
  "model_family": "srpa_innovations_v2",
  "report_script": "/data/SRPA-Net/reports/collect_completed_experiments.py",
  "seed": 42,
  "pretrained_checkpoint": "/data/SRPA-Net/checkpoints/SpecAware_Base_model.pth",
  "metadata": "/data/SRPA-Net/configs/sensor_metadata_224.json",
  "text_embeddings": "/data/SRPA-Net/configs/text_embeddings.pt",
  "cache_root": "/home/chic/oilspill_benchmark_cache/224_fullbands",
  "band_indices": null,
  "max_steps": 20000,
  "batch_size": 8,
  "micro_batch": 4,
  "workers": 4,
  "lr": 0.0001,
  "betas": [
    0.9,
    0.95
  ],
  "weight_decay": 0.0001,
  "val_interval": 500,
  "checkpoint_interval": 500,
  "adapter_rank": 16,
  "experts": 4,
  "activation_checkpointing": true,
  "precision": "fp16_mixed",
  "variant_labels": {
    "baseline": "2×2 Baseline：无可靠性、无细节补偿",
    "reliability_only": "2×2 A：仅全局可靠性",
    "detail_only": "2×2 B：仅光谱细节补偿",
    "reliability_detail": "2×2 A+B：全局可靠性＋光谱细节补偿"
  },
  "variants": {
    "baseline": {
      "use_reliability": false,
      "use_adapters": false,
      "local_reliability": false,
      "spatial_adapter": false,
      "spectral_detail": false
    },
    "reliability_only": {
      "use_reliability": true,
      "use_adapters": false,
      "local_reliability": false,
      "spatial_adapter": false,
      "spectral_detail": false
    },
    "detail_only": {
      "use_reliability": false,
      "use_adapters": false,
      "local_reliability": false,
      "spatial_adapter": false,
      "spectral_detail": true
    },
    "reliability_detail": {
      "use_reliability": true,
      "use_adapters": false,
      "local_reliability": false,
      "spatial_adapter": false,
      "spectral_detail": true
    }
  },
  "experimental_design": "Matched 2x2 factorial: 00 baseline, 10 reliability, 01 spectral detail, 11 both; four fresh independent runs from the same official checkpoint and identical full initial state/RNG.",
  "runtime_defaults": {
    "activation_checkpointing": false,
    "defer_conv_checks": true,
    "fused_adamw": true,
    "micro_batch": 8,
    "ghost_batch_size": 4,
    "fp32_retry_micro_batch": 4,
    "effective_batch": 8,
    "reason": "Identical execution settings for all four fresh factorial arms from update zero."
  },
  "verify_factorial_initialization": true,
  "factorial_arms": {
    "baseline": "baseline",
    "A": "reliability_only",
    "B": "detail_only",
    "AB": "reliability_detail"
  },
  "factorial_analysis": {
    "metrics": [
      "oil_precision",
      "oil_recall",
      "oil_F1",
      "oil_IoU",
      "mIoU"
    ],
    "interaction": "100 * (AB - A - B + baseline), in percentage points",
    "selection": "best validation mIoU separately in each arm; identical 500-step validation schedule",
    "interpretation": "Descriptive single-seed interaction on bounded metrics, not statistical significance; no selection or tuning using test scores."
  }
}
